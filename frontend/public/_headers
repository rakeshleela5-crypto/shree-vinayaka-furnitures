/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://api.qrserver.com; connect-src 'self' https://shree-vinayaka-furnitures-production.up.railway.app https://*.railway.app http://localhost:8000 ws://localhost:8000 wss://shree-vinayaka-furnitures-production.up.railway.app wss://*.railway.app https://srivinayakafurnitures.pages.dev https://*.pages.dev https://*.r2.cloudflarestorage.com https://*.decentro.tech https://in.staging.decentro.tech https://api.qrserver.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self';

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/200.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/site.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
